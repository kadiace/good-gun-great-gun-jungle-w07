    completion: 0
    requiredSignal: 
    allowedActions: []
  - id: D1_2_Extension_OrderHeard_3
    title: "\uD29C\uD1A0\uB9AC\uC5BC"
    description: "\uCF54\uC5B4\uB098 \uC774\uBBF8 \uB2E8 \uBE14\uB85D\uC758 \uBA74\uC744
      \uC88C\uD074\uB9AD\uD558\uBA74 \uADF8 \uC790\uB9AC\uC5D0 \uBAA8\uB4C8\uC774
      \uC124\uCE58\uB429\uB2C8\uB2E4. E\uB294 \uC0AD\uC81C \uBAA8\uB4DC, Ctrl+Z\uB294
      \uB418\uB3CC\uB9AC\uAE30, \uC6B0\uD074\uB9AD \uB4DC\uB798\uADF8\uB294 \uC791\uC5C5\uB300
      \uD68C\uC804\uC785\uB2C8\uB2E4."
    objective: 
    completion: 0
    requiredSignal: 
    allowedActions: []
  - id: D1_2_Extension_OrderHeard_4
    title: "\uD29C\uD1A0\uB9AC\uC5BC"
    description: "\uBAA8\uB4C8\uC740 \uACF5\uC9DC\uAC00 \uC544\uB2D9\uB2C8\uB2E4!
