--- !u!114 &940220562981845869
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4000978480502391409}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%>GOOD GUN GREAT GUN   /   RANGE DESK</size>\n<size=165%><b>\uC2DC\uD5D8
    \xB7 \uB9C8\uAC10 \uC548\uB0B4</b></size>\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n<b>01 
    \uD45C\uC801 \uC900\uBE44</b>\n\uC606\uC758 \uC2A4\uD3F0 \uC885\uC744 \uBCF4\uACE0
    F\uB97C \uB204\uB985\uB2C8\uB2E4.\n\uC120\uD0DD\uCC3D\uC5D0\uC11C \uC6D0\uD558\uB294
    \uD45C\uC801\uC744 \uACE0\uB985\uB2C8\uB2E4.\n\uACF5\uAC04\uC774 \uCC28 \uC788\uC73C\uBA74
    \uBA3C\uC800 \uCCAD\uC18C\uD558\uC138\uC694.\n\n<b>02  \uC0AC\uACA9 \uC2DC\uD5D8</b>\n\uBB34\uAE30\uB97C
    \uC7A5\uCC29\uD558\uACE0 \uC88C\uD074\uB9AD\uC73C\uB85C \uBC1C\uC0AC\uD569\uB2C8\uB2E4.\n\uBC1C\uC0AC
    \uBC29\uD5A5\uACFC \uBAA8\uB4C8 \uD6A8\uACFC\uB97C \uD655\uC778\uD558\uC138\uC694.\n\uC218\uC815\uC774
    \uD544\uC694\uD558\uBA74 \uC791\uC5C5\uB300\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n\n<b>03 
    \uC815\uB9AC\uC640 \uB9C8\uAC10</b>\n\uD45C\uC801 \uC120\uD0DD\uCC3D\uC758 \uCCAD\uC18C
    \uBC84\uD2BC\uC73C\uB85C\n\uC18C\uD658\uD55C \uD45C\uC801\uACFC \uD30C\uD3B8\uC744
    \uCE58\uC6C1\uB2C8\uB2E4.\n\uC4F0\uB808\uAE30\uD1B5\uC5D0\uC11C F : \uBB34\uAE30
    \uD3D0\uAE30 / \uC81C\uC791\uBE44 \uD658\uBD88\n\uC601\uC5C5 \uC885\uB8CC \uD6C4
    \uC815\uC0B0\uACFC \uC6D4\uC138\uB97C \uD655\uC778\uD558\uC138\uC694.\n\uAC8C\uC784
    \uC800\uC7A5\uC740 ESC \uBA54\uB274\uC5D0\uC11C \uC9C4\uD589\uD569\uB2C8\uB2E4.\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n<size=85%>F 
    \uB4E4\uC5B4\uC11C \uC77D\uAE30 / \uB0B4\uB824\uB193\uAE30   \xB7   ESC  \uB0B4\uB824\uB193\uAE30</size>"
